                            <i class="fa-solid fa-compass-drafting" style="color:#ffffff; font-size:1.1rem; margin-bottom:0.4rem; display:block;"></i>
                            <span style="color:white; font-size:1.05rem; font-weight:700;">New Food Manufacturing Project Development</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================================
         5. My Approach
         ========================================================================= -->
    <section class="section" id="my-approach" style="background: #ffffff; padding-top: 1.5rem; padding-bottom: 2rem;">
        <div class="container">
            <div class="section-header text-center" style="margin-bottom: 2.5rem;">
                <h2 class="section-title">MY APPROACH</h2>
            </div>

            <div class="approach-grid">
                <!-- Step 1 -->
                <div class="approach-card">
                    <div class="approach-img-wrapper">
